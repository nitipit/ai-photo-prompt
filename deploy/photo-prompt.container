[Unit]
Description=Photo Prompt application
Requires=photo-prompt.pod photo-prompt.network
After=photo-prompt.pod photo-prompt.network

[Container]
ContainerName=photo-prompt
Image=localhost/photo-prompt:deploy
Pod=photo-prompt.pod
User=10001:10001
WorkingDir=/app
Environment=PHOTO_PROMPT_CONFIG=/etc/photo-prompt/app.toml
Volume=%h/photo-prompt/app.toml:/etc/photo-prompt/app.toml:ro,z
Volume=photo-prompt-state:/var/lib/photo-prompt/state:rw
Volume=photo-prompt-generated:/var/lib/photo-prompt/generated:rw
Volume=photo-prompt-pi-home:/home/photo-prompt/.pi:rw
Tmpfs=/run/photo-prompt:rw,size=512m
HealthCmd=/opt/venv/bin/python -c "import json,urllib.request; value=json.load(urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)); raise SystemExit(0 if value.get('ready') is True else 1)"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3

[Service]
CPUQuota=150%
MemoryHigh=1G
MemoryMax=1536M
TasksMax=256
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
